<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="#1A1C23"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="#2B2E38"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- File / Folder Icon Frame -->
        <FrameLayout
            android:id="@+id/iconFrame"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="#23252B"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tvFileBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="#E5A93B"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="📁" />
        </FrameLayout>

        <!-- File Name -->
        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvFileType"
            app:layout_constraintStart_toEndOf="@id/iconFrame"
            app:layout_constraintTop_toTopOf="@id/iconFrame"
            tools:text="Documents" />

        <!-- File Details (Size / Item Count / Date) -->
        <TextView
            android:id="@+id/tvFileDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8E8E93"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/tvFileType"
            app:layout_constraintStart_toEndOf="@id/iconFrame"
            app:layout_constraintTop_toBottomOf="@id/tvFileName"
            tools:text="14 items • May 2025" />

        <!-- File Type Badge -->
        <TextView
            android:id="@+id/tvFileType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#252833"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="#E5A93B"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="SmallSp"
            tools:text="FOLDER" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
