<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPerson"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="0dp"
    app:cardElevation="2dp"
    app:strokeColor="#E5E7EB"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPersonName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Ankur Goyal" />

            <TextView
                android:id="@+id/tvPersonGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="#E0E7FF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#3730A3"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="VIP Group"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvDeletedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#FEE2E2"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="DELETED"
                android:textColor="#DC2626"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:ignore="HardcodedText"
                tools:visibility="visible" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvPersonDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#4B5563"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Senior Software Engineer at Monk Mindset"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvPersonPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#6B7280"
            android:textSize="13sp"
            tools:text="+91 9876543210" />

        <TextView
            android:id="@+id/tvPersonEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#6B7280"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="ankur@monkmindset.com"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvPersonLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#2563EB"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="https://monkmindset.com"
            tools:visibility="visible" />

        <!-- Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEdit"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="10dp"
                android:text="Edit"
                android:textColor="#2563EB"
                android:textSize="13sp"
                app:iconPadding="0dp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="10dp"
                android:text="Delete"
                android:textColor="#DC2626"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRestore"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="10dp"
                android:text="Restore"
                android:textColor="#16A34A"
                android:textSize="13sp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
